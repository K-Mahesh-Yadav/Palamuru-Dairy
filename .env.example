# ---------------------------------------------------------------------------
# EXPOSURE RULE — read before adding anything here.
#
# Vite replaces `import.meta.env.VITE_*` with STRING LITERALS at build time.
# `dist/assets/*.js` is a publicly served file. Therefore a VITE_-prefixed
# variable is exactly equivalent to publishing its value on a webpage.
#
# Variables WITHOUT the VITE_ prefix are stripped and unavailable at runtime.
# That is the guardrail. Never put a key, token or credential in this file.
#
# This site has zero secrets: the phone and WhatsApp numbers below are already
# printed on a public promotional banner.
# ---------------------------------------------------------------------------

# Canonical origin, used for <link rel="canonical"> and og:url.
# TODO(domain): no domain purchased yet — see PLAN.md B8.
VITE_SITE_URL=https://palamuru-dairy.vercel.app

# WhatsApp number in E.164 without the leading '+' (wa.me format).
# TODO(whatsapp): assumed identical to the banner mobile 9381466419 — UNCONFIRMED.
VITE_WHATSAPP_NUMBER=919381466419
